{
  "kaz_intro": {
    "id": "kaz_intro",
    "speaker": "Kaz",
    "portrait": "kaz",
    "start": "greet",
    "nodes": {
      "greet": {
        "text": [
          "You look like someone who needs rent money.",
          "Ferristech has a sealed case in their cold room.",
          "Wetware. Neural interface. Very illegal, very paid."
        ],
        "choices": [
          { "text": "How much?", "goto": "terms" },
          {
            "text": "Why me?",
            "goto": "why"
          },
          {
            "text": "[Etiquette] I know what wetwire moves for. Double it.",
            "check": { "attr": "charisma", "skill": "etiquette", "dc": 2 },
            "onSuccess": {
              "goto": "haggle_win",
              "do": [{ "setFlag": "kaz_respects_you" }]
            },
            "onFail": { "goto": "haggle_lose" }
          },
          { "text": "Not interested.", "end": true }
        ]
      },
      "terms": {
        "text": ["Three thousand nuyen. Two points of karma with people who count.", "Case comes to me sealed. Sealed, runner."],
        "choices": [
          { "text": "I'm in.", "goto": "accept" },
          { "text": "Let me think about it.", "end": true }
        ]
      },
      "why": {
        "text": [
          "Because you're new enough that Ferristech has no file on you,",
          "and desperate enough not to ask a second question.",
          "That was the second question."
        ],
        "choices": [
          { "text": "Fair. What's the pay?", "goto": "terms" },
          { "text": "I'm in.", "goto": "accept" }
        ]
      },
      "haggle_win": {
        "text": [
          "...Huh. You've done this before.",
          "Fine. Three thousand, and I forget you lowballed me.",
          "Talk to Vex in the alley north of here. She'll kit you out."
        ],
        "choices": [{ "text": "Pleasure doing business.", "goto": "accept" }]
      },
      "haggle_lose": {
        "text": [
          "Cute. You read one forum post about street rates.",
          "Three thousand. Take it or freeze."
        ],
        "choices": [
          { "text": "Taking it.", "goto": "accept" },
          { "text": "Freezing.", "end": true }
        ]
      },
      "accept": {
        "text": [
          "Vex is in Sodium Alley, north. Talk to her before you go in.",
          "She has opinions about doors."
        ],
        "onEnter": [{ "startJob": "job_wetwire" }],
        "choices": [{ "text": "On it.", "end": true }]
      }
    }
  },

  "kaz_busy": {
    "id": "kaz_busy",
    "speaker": "Kaz",
    "portrait": "kaz",
    "start": "greet",
    "nodes": {
      "greet": {
        "text": ["Case isn't in your hands, so this isn't a conversation.", "Ferristech. Cold room. Go."],
        "choices": [
          { "text": "Remind me how to get in?", "goto": "hint" },
          { "text": "Going.", "end": true }
        ]
      },
      "hint": {
        "text": [
          "Backlot's east of the alley. There's a door with a reader.",
          "Crack it, badge it, or sweet-talk the meat standing next to it.",
          "I don't care which."
        ],
        "choices": [{ "text": "Right.", "end": true }]
      }
    }
  },

  "kaz_handover": {
    "id": "kaz_handover",
    "speaker": "Kaz",
    "portrait": "kaz",
    "start": "greet",
    "nodes": {
      "greet": {
        "text": [
          "You're still breathing and the seal's intact.",
          "I had you at forty percent.",
          "Hand it over and we're square."
        ],
        "choices": [
          {
            "text": "Here. Three thousand, as agreed.",
            "goto": "paid"
          },
          {
            "text": "[Etiquette] Sable offered more. Beat it or I walk.",
            "if": { "flag": "met_sable" },
            "check": { "attr": "charisma", "skill": "etiquette", "dc": 3 },
            "onSuccess": {
              "goto": "paid_extra",
              "do": [{ "setFlag": "kaz_respects_you" }]
            },
            "onFail": { "goto": "haggle_fail" }
          },
          { "text": "I haven't decided who gets this yet.", "end": true }
        ]
      },
      "paid": {
        "text": ["Clean work. Money's on your stick.", "I'll have something else for you soon. I always do."],
        "onEnter": [
          { "takeItem": "wetwire_case" },
          { "completeJob": "job_wetwire" },
          { "setFlag": "wetwire_resolved" },
          { "setFlag": "kaz_trusts_you" }
        ],
        "choices": [{ "text": "Call me.", "end": true }]
      },
      "paid_extra": {
        "text": [
          "...You met Sable and came here anyway.",
          "That's worth something. Four thousand. Don't tell anyone."
        ],
        "onEnter": [
          { "takeItem": "wetwire_case" },
          { "nuyen": 1000 },
          { "completeJob": "job_wetwire" },
          { "setFlag": "wetwire_resolved" },
          { "setFlag": "kaz_trusts_you" }
        ],
        "choices": [{ "text": "Wouldn't dream of it.", "end": true }]
      },
      "haggle_fail": {
        "text": ["Then go sell it to Sable and see how long you keep the money.", "Three thousand. Last offer."],
        "choices": [
          { "text": "Fine. Three.", "goto": "paid" },
          { "text": "I'll think about it.", "end": true }
        ]
      }
    }
  },

  "kaz_after": {
    "id": "kaz_after",
    "speaker": "Kaz",
    "portrait": "kaz",
    "start": "greet",
    "nodes": {
      "greet": {
        "text": ["Go home, runner. Sleep. Spend something."],
        "choices": [
          {
            "text": "(He won't meet your eye.)",
            "if": { "flag": "kaz_burned" },
            "goto": "burned"
          },
          { "text": "Later, Kaz.", "end": true }
        ]
      },
      "burned": {
        "text": [
          "You sold my case to Sable.",
          "I'm not angry. I'm *filed*. That's worse.",
          "Don't take work in this district for a while."
        ],
        "choices": [{ "text": "Understood.", "end": true }]
      }
    }
  }
}
