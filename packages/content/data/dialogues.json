        "choices": [
          {
            "text": "(Step back.)",
            "end": true
          }
        ]
      }
    }
  },
  "terminal_backlot": {
    "id": "terminal_backlot",
    "speaker": "Yard Terminal",
    "portrait": "runner",
    "start": "greet",
    "nodes": {
