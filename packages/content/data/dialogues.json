            "text": "(Log off.)",
            "end": true
          }
        ]
      },
      "nothing": {
        "text": [
          "Access denied. The terminal makes a noise like a disappointed parent."
        ],
        "choices": [
          {
            "text": "(Log off.)",
            "end": true
          }
        ]
      }
    }
  },
  "vendor_intro": {
